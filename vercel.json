{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/donation", "destination": "/donations", "permanent": true },
    { "source": "/donation.html", "destination": "/donations", "permanent": true },
    { "source": "/ticket", "has": [{ "type": "query", "key": "ticket" }], "destination": "/ticket-view", "permanent": true },
    { "source": "/ticket.html", "has": [{ "type": "query", "key": "ticket" }], "destination": "/ticket-view", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
