rules_version = '2';

// Firestore security rules for the Original Concert 3.0 site.
//
// The "tickets" collection must stay publicly READable and CREATE-able so the
// public no-login registration flow and the QR verification page keep working.
// However, destructive/tampering operations are locked down:
//   - update  : denied (existing tickets cannot be edited from the browser)
//   - delete  : allowed ONLY for the authenticated admin account
// (Delete is also the only operation the admin page performs.)
//
// NOTE: rule expressions are evaluated on the server and are NOT bypassable
// by editing the client code, so this delete restriction is real enforcement
// even though the admin login screen is a UI gate.

service cloud.firestore {
  match /databases/{database}/documents {

    // Public tickets data - anonymous reads and creates allowed.
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.token.email == "onyeanusiifeanyi@gmail.com";
    }

    // Deny access to every other collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}